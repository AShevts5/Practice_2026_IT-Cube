APP_NAME=it-cube-backend
APP_ENV=production
DEBUG=false
API_V1_PREFIX=/api/v1

SECRET_KEY=replace-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=30
PASSWORD_HASH_SCHEME=bcrypt

OTP_LENGTH=6
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=false

SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER=IT-CUBE

EXPORT_MAX_ROWS=10000
